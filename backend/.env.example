# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me   # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=True             # must be False in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=forge_and_flight
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Google sign-in: OAuth 2.0 Web client id (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_OAUTH_CLIENT_ID=

# AI Engine (Ollama / DeepSeek)
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Production only
# DJANGO_REDIS_URL=redis://localhost:6379/0
# BEHIND_TLS_PROXY=True
# NUM_PROXIES=1

# Demo seed data (seed_demo refuses to run unless DEBUG=True)
# DEMO_PASSWORD=
