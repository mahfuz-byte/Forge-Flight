# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me   # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=True             # must be False in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=forge_and_flight
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Set to require when connecting to Supabase Postgres.
# DB_SSLMODE=require

# Supabase Storage: enable S3 access in its dashboard, then copy these values.
# Keep the bucket private; file URLs are signed by Django.
# SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=PROJECT_REGION
# SUPABASE_S3_BUCKET=forge-flight-media
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=

# Production: use the Supabase session pooler URI (port 5432), including its
# database password. Keep this value in Render secrets, never in Git.
# DATABASE_URL=postgresql://...

# Google sign-in: OAuth 2.0 Web client id (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_OAUTH_CLIENT_ID=

# AI Engine (Ollama / DeepSeek)
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
# Set on Vercel when Ollama is reached through the authenticated local bridge.
# OLLAMA_BRIDGE_TOKEN=

# Production only
# DJANGO_REDIS_URL=redis://localhost:6379/0
# BEHIND_TLS_PROXY=True
# NUM_PROXIES=1
# DJANGO_MEDIA_ROOT=/opt/render/project/src/backend/media

# Demo seed data (seed_demo refuses to run unless DEBUG=True)
# DEMO_PASSWORD=
